# @s = joueur qui vote (mg.vote = numéro du jeu)
scoreboard players operation @s mg.vc = @s mg.vote
function mg:vote/refresh
execute at @s run playsound minecraft:ui.button.click master @s ~ ~ ~ 1 1.4
execute if score @s mg.vote matches 1 run tellraw @s [{"text":"☑ Tu votes pour : ","color":"gray"},{"text":"❄ Spleef","color":"aqua","bold":true},{"text":" ("},{"score":{"name":"Spleef","objective":"mg.vb"}},{"text":" vote(s))","color":"gray"}]
