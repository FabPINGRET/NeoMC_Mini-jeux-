# @s = joueur : affiche le détail des votes en chat
function mg:vote/refresh
tellraw @s [{"text":"\n☑ VOTES EN COURS","color":"green","bold":true}]
execute if score $vn mg.st matches 0 run tellraw @s [{"text":" Aucun vote pour le moment.","color":"gray"}]
execute if score Spleef mg.vb matches 1.. run tellraw @s [{"text":" ▸ ","color":"gray"},{"text":"❄ Spleef","color":"aqua"},{"text":" : ","color":"gray"},{"score":{"name":"Spleef","objective":"mg.vb"},"color":"gold","bold":true}]
execute if score TNT-Run mg.vb matches 1.. run tellraw @s [{"text":" ▸ ","color":"gray"},{"text":"✷ TNT Run","color":"red"},{"text":" : ","color":"gray"},{"score":{"name":"TNT-Run","objective":"mg.vb"},"color":"gold","bold":true}]
