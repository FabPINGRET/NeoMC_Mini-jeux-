# Donne $(n) Moutons-Fusées à @s (consommable → détection fiable du clic droit)
$give @s minecraft:gunpowder[custom_data={mg_sheep:1b},custom_name=[{"text":"Mouton-Fusée","color":"aqua","italic":false}],enchantment_glint_override=true,consumable={consume_seconds:0.05,animation:"none",sound:"minecraft:entity.sheep.ambient",has_consume_particles:false}] $(n)
