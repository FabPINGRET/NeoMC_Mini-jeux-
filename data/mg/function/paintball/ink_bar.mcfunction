# Barre d'encre (actionbar), @s = joueur
execute if entity @s[team=mg_red] if score @s mg.pi matches 0..19 run title @s actionbar [{"text":"Encre ","color":"gray"},{"text":"░░░░░░░░░░","color":"gold"}]
