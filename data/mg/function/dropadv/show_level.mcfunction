execute if score @s mg.dlv matches 1 run title @s subtitle [{"text":"Niveau 1/10 : Entonnoirs, rayons et nuages pastel : suis les couleurs !","color":"gray"}]
execute if score @s mg.dlv matches 2 run title @s subtitle [{"text":"Niveau 2/10 : Boules qui tournent, barres pivotantes, spirale qui se resserre.","color":"gray"}]
execute if score @s mg.dlv matches 3 run title @s subtitle [{"text":"Niveau 3/10 : Poutres et toiles, galeries et filons, puis le lac souterrain.","color":"gray"}]
execute if score @s mg.dlv matches 4 run title @s subtitle [{"text":"Niveau 4/10 : Rideaux percés, grilles croisées, puis le damier final.","color":"gray"}]
execute if score @s mg.dlv matches 5 run title @s subtitle [{"text":"Niveau 5/10 : Des planchers troués... mais certains trous sont fermés par du verre !","color":"gray"}]
execute if score @s mg.dlv matches 6 run title @s subtitle [{"text":"Niveau 6/10 : Basalte et champignons, ponts de forteresse, puis le cœur du volcan.","color":"gray"}]
execute if score @s mg.dlv matches 7 run title @s subtitle [{"text":"Niveau 7/10 : Tu es minuscule dans un salon : lustre, étagères, table... vise le bocal !","color":"gray"}]
execute if score @s mg.dlv matches 8 run title @s subtitle [{"text":"Niveau 8/10 : Étagères géantes, livres volants, lustres... vise l'encrier.","color":"gray"}]
execute if score @s mg.dlv matches 9 run title @s subtitle [{"text":"Niveau 9/10 : Canopée, branches et toiles, champignons... les nénuphars ne sont PAS de l'eau !","color":"gray"}]
execute if score @s mg.dlv matches 10 run title @s subtitle [{"text":"Niveau 10/10 : Nuages, arcs-en-ciel croisés, îles volantes : un seul bloc d'eau au fond !","color":"gray"}]
