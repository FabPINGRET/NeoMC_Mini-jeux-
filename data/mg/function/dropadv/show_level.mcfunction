execute if score @s mg.dlv matches 2 run title @s title [{"text":"Spirale","color":"yellow","bold":true}]
execute if score @s mg.dlv matches 3 run title @s title [{"text":"La mine","color":"gray","bold":true}]
execute if score @s mg.dlv matches 4 run title @s title [{"text":"Rideaux","color":"white","bold":true}]
execute if score @s mg.dlv matches 5 run title @s title [{"text":"Trous piégés","color":"dark_purple","bold":true}]
execute if score @s mg.dlv matches 6 run title @s title [{"text":"L'Enfer","color":"red","bold":true}]
execute if score @s mg.dlv matches 7 run title @s title [{"text":"Le salon géant","color":"gold","bold":true}]
execute if score @s mg.dlv matches 8 run title @s title [{"text":"La bibliothèque","color":"dark_red","bold":true}]
