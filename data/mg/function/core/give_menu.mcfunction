# Donne l'objet menu (admins) ou l'objet de vote (autres joueurs)
# Remplace d'abord toute canne existante ; ne détruit jamais un autre objet : si le slot 4 est occupé, l'objet est donné dans un slot libre
clear @s minecraft:carrot_on_a_stick
scoreboard players set $gmi mg.t 0
execute unless items entity @s hotbar.4 * run scoreboard players set $gmi mg.t 1
execute if entity @s[tag=mg.admin] if score $gmi mg.t matches 1 run item replace entity @s hotbar.4 with minecraft:carrot_on_a_stick[custom_name=[{"text":"≡ MENU","color":"gold","italic":false,"bold":true}],custom_data={mg_menu:1b},enchantment_glint_override=true,consumable={consume_seconds:0.05,animation:"none",sound:"minecraft:ui.button.click",has_consume_particles:false}]
execute if entity @s[tag=mg.admin] unless score $gmi mg.t matches 1 run give @s minecraft:carrot_on_a_stick[custom_name=[{"text":"≡ MENU","color":"gold","italic":false,"bold":true}],custom_data={mg_menu:1b},enchantment_glint_override=true,consumable={consume_seconds:0.05,animation:"none",sound:"minecraft:ui.button.click",has_consume_particles:false}]
execute unless entity @s[tag=mg.admin] if score $gmi mg.t matches 1 run item replace entity @s hotbar.4 with minecraft:carrot_on_a_stick[custom_name=[{"text":"☑ VOTE","color":"green","italic":false,"bold":true}],custom_data={mg_vote:1b},enchantment_glint_override=true,consumable={consume_seconds:0.05,animation:"none",sound:"minecraft:ui.button.click",has_consume_particles:false}]
execute unless entity @s[tag=mg.admin] unless score $gmi mg.t matches 1 run give @s minecraft:carrot_on_a_stick[custom_name=[{"text":"☑ VOTE","color":"green","italic":false,"bold":true}],custom_data={mg_vote:1b},enchantment_glint_override=true,consumable={consume_seconds:0.05,animation:"none",sound:"minecraft:ui.button.click",has_consume_particles:false}]
