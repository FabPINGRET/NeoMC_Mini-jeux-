# Règles du monde de Terra Nova (propres à la dimension sur Paper) : jour fixe, pas d'apparitions naturelles, inventaire gardé
execute in mg:terranova run difficulty normal
execute in mg:terranova run gamerule spawn_mobs false
execute in mg:terranova run gamerule mob_griefing false
execute in mg:terranova run gamerule keep_inventory true
execute in mg:terranova run gamerule immediate_respawn true
execute in mg:terranova run gamerule advance_time false
execute in mg:terranova run gamerule advance_weather false
execute in mg:terranova run time set 2000
execute in mg:terranova run weather clear
