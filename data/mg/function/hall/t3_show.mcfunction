# Texte du stand $(k) : libellé + top 3 (résolu sur le tampon, gardé dans t3x.$(k)) — macro {k, lbl, col}
$execute if data storage mg:hall t3.$(k)[2] run item modify entity @e[type=minecraft:item_display,tag=mg.hallbuf,limit=1] contents {function:"minecraft:set_name",entity:"this",target:"custom_name",name:[{text:"$(lbl)",color:"$(col)",bold:true},{text:"\n🥇 ",color:"gold",bold:false},{nbt:"t3.$(k)[0].n",storage:"mg:hall",interpret:true,color:"white",bold:false},{text:" — ",color:"dark_gray",bold:false},{nbt:"t3.$(k)[0].s",storage:"mg:hall",color:"yellow",bold:false},{text:"\n🥈 ",color:"gray",bold:false},{nbt:"t3.$(k)[1].n",storage:"mg:hall",interpret:true,color:"white",bold:false},{text:" — ",color:"dark_gray",bold:false},{nbt:"t3.$(k)[1].s",storage:"mg:hall",color:"yellow",bold:false},{text:"\n🥉 ",color:"gold",bold:false},{nbt:"t3.$(k)[2].n",storage:"mg:hall",interpret:true,color:"white",bold:false},{text:" — ",color:"dark_gray",bold:false},{nbt:"t3.$(k)[2].s",storage:"mg:hall",color:"yellow",bold:false}]}
$execute if data storage mg:hall t3.$(k)[1] unless data storage mg:hall t3.$(k)[2] run item modify entity @e[type=minecraft:item_display,tag=mg.hallbuf,limit=1] contents {function:"minecraft:set_name",entity:"this",target:"custom_name",name:[{text:"$(lbl)",color:"$(col)",bold:true},{text:"\n🥇 ",color:"gold",bold:false},{nbt:"t3.$(k)[0].n",storage:"mg:hall",interpret:true,color:"white",bold:false},{text:" — ",color:"dark_gray",bold:false},{nbt:"t3.$(k)[0].s",storage:"mg:hall",color:"yellow",bold:false},{text:"\n🥈 ",color:"gray",bold:false},{nbt:"t3.$(k)[1].n",storage:"mg:hall",interpret:true,color:"white",bold:false},{text:" — ",color:"dark_gray",bold:false},{nbt:"t3.$(k)[1].s",storage:"mg:hall",color:"yellow",bold:false}]}
$execute if data storage mg:hall t3.$(k)[0] unless data storage mg:hall t3.$(k)[1] run item modify entity @e[type=minecraft:item_display,tag=mg.hallbuf,limit=1] contents {function:"minecraft:set_name",entity:"this",target:"custom_name",name:[{text:"$(lbl)",color:"$(col)",bold:true},{text:"\n🥇 ",color:"gold",bold:false},{nbt:"t3.$(k)[0].n",storage:"mg:hall",interpret:true,color:"white",bold:false},{text:" — ",color:"dark_gray",bold:false},{nbt:"t3.$(k)[0].s",storage:"mg:hall",color:"yellow",bold:false}]}
$data modify storage mg:hall t3x.$(k) set from entity @e[type=minecraft:item_display,tag=mg.hallbuf,limit=1] item.components."minecraft:custom_name"
$data modify entity @e[type=minecraft:text_display,tag=mg.h3_$(k),limit=1] text set from storage mg:hall t3x.$(k)
