# Règles du monde d'Ombrelune : crépuscule fixe, pas d'apparitions naturelles, inventaire gardé
execute in mg:ombrelune run difficulty normal
execute in mg:ombrelune run gamerule spawn_mobs false
execute in mg:ombrelune run gamerule mob_griefing false
execute in mg:ombrelune run gamerule keep_inventory true
execute in mg:ombrelune run gamerule immediate_respawn true
execute in mg:ombrelune run gamerule advance_time false
execute in mg:ombrelune run gamerule advance_weather false
execute in mg:ombrelune run time set 11200
execute in mg:ombrelune run weather clear
