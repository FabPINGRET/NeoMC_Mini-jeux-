execute store success score $dlg mg.st run dialog show @s {"type":"minecraft:multi_action","title":{"text":"🔮 Archimagesse Liora","color":"light_purple","bold":true},"external_title":{"text":"🔮 Archimagesse Liora","color":"light_purple"},"pause":false,"can_close_with_escape":true,"columns":1,"body":[{"type":"minecraft:plain_message","contents":[{"text":"Te voilà enfin, Porteur de l'Aube. Il y a cent ans, l'archimage Malveth a brisé la Pierre-Lune qui protégeait Ombrelune. Le ciel s'est assombri, les morts se sont relevés, et ses huit éclats ont été dispersés aux quatre vents. Havreclair est la dernière cité libre. La prophétie annonçait ta venue : toi seul peux réunir les éclats. Mais d'abord, apprends à te battre.","color":"white"}],"width":320}],"actions":[{"label":[{"text":"Je suis prêt","color":"green","bold":true}],"tooltip":[{"text":"Prologue · L'Aube éteinte","color":"gray"}],"action":{"type":"minecraft:run_command","command":"trigger mg.oltk set 1000"}},{"label":[{"text":"Au revoir","color":"gray"}],"tooltip":[{"text":"Fermer","color":"gray"}],"action":{"type":"minecraft:run_command","command":"trigger mg.oltk set 8"}}]}
