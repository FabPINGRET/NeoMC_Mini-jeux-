# Barre du bas en bataille : ballons, temps restant, objet, vitesse
execute if score @s mg.krl matches 1.. run return run title @s actionbar [{"text":"🎲 ","color":"gold"},{"text":"🍌 🟢 🔴 🍄 ⭐ ⚡ 💣 👻","color":"white"},{"text":"  ...","color":"gray"}]
execute if entity @s[tag=mg.kout] run return run title @s actionbar [{"text":"💥 Éliminé : attends la fin de la bataille","color":"gray"}]
scoreboard players operation $kmh mg.st = @s mg.ksp
scoreboard players operation $kmh mg.st *= #kkmh mg.st
scoreboard players operation $kmh mg.st /= #k100 mg.st
execute if score $kmh mg.st matches ..-1 run scoreboard players operation $kmh mg.st *= #km1 mg.st
scoreboard players set $ksl mg.st 3600
scoreboard players operation $ksl mg.st -= $ktime mg.st
scoreboard players operation $ksl mg.st /= #k20 mg.st
execute unless score @s mg.khi matches 1.. if score @s mg.kit matches 0 run title @s actionbar [{"text":"🎈 ","color":"red"},{"score":{"name":"@s","objective":"mg.kbl"},"color":"white","bold":true},{"text":"   ⏱ ","color":"gold"},{"score":{"name":"$ksl","objective":"mg.st"},"color":"yellow"},{"text":" s   ","color":"gold"},{"text":"(pas d'objet)","color":"dark_gray"},{"text":"   ","color":"gray"},{"score":{"name":"$kmh","objective":"mg.st"},"color":"aqua"},{"text":" km/h","color":"dark_aqua"}]
