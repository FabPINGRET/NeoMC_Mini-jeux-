# Mob Arena — classe TANK (@s)
give @s minecraft:stone_sword[unbreakable={},enchantments={knockback:1}]
give @s minecraft:golden_apple 3
item replace entity @s armor.head with minecraft:diamond_helmet[unbreakable={},enchantments={protection:2}]
item replace entity @s armor.chest with minecraft:diamond_chestplate[unbreakable={},enchantments={protection:2}]
item replace entity @s armor.legs with minecraft:iron_leggings[unbreakable={},enchantments={protection:2}]
item replace entity @s armor.feet with minecraft:iron_boots[unbreakable={},enchantments={protection:2}]
effect give @s minecraft:health_boost infinite 2 true
effect give @s minecraft:slowness infinite 0 true
