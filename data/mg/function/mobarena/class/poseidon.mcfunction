# Mob Arena — classe POSÉIDON (@s) : trident lancé qui revient (Loyauté)
give @s minecraft:trident[unbreakable={},enchantments={loyalty:3,impaling:3,unbreaking:3}]
give @s minecraft:golden_apple 1
give @s minecraft:cooked_beef 8
item replace entity @s armor.head with minecraft:turtle_helmet[unbreakable={}]
item replace entity @s armor.chest with minecraft:iron_chestplate[unbreakable={}]
item replace entity @s armor.legs with minecraft:iron_leggings[unbreakable={}]
item replace entity @s armor.feet with minecraft:iron_boots[unbreakable={}]
effect give @s minecraft:water_breathing infinite 0 true
