# Chien de l'enfer (loup calciné, variante mg:hellhound du resource pack) : peu de vie, très rapide, lâché sur le joueur le plus proche
$execute if score $rp mg.st matches 1 run summon minecraft:wolf ~ ~ ~ {Tags:["mg.zz","mg.gtg","mg.mob"],PersistenceRequired:1b,CanPickUpLoot:0b,DeathLootTable:"minecraft:empty",Health:$(hpd)f,sound_variant:"minecraft:angry",variant:"mg:hellhound",attributes:[{id:"minecraft:max_health",base:$(hpd)d},{id:"minecraft:follow_range",base:64d},{id:"minecraft:movement_speed",base:$(spd)d},{id:"minecraft:attack_damage",base:4d},{id:"minecraft:scale",base:1.15d}]}
$execute unless score $rp mg.st matches 1 run summon minecraft:wolf ~ ~ ~ {Tags:["mg.zz","mg.gtg","mg.mob"],PersistenceRequired:1b,CanPickUpLoot:0b,DeathLootTable:"minecraft:empty",Health:$(hpd)f,sound_variant:"minecraft:angry",variant:"minecraft:black",attributes:[{id:"minecraft:max_health",base:$(hpd)d},{id:"minecraft:follow_range",base:64d},{id:"minecraft:movement_speed",base:$(spd)d},{id:"minecraft:attack_damage",base:4d},{id:"minecraft:scale",base:1.15d}]}
execute as @e[type=minecraft:wolf,tag=mg.zz,distance=..2] at @s run function mg:zx/dog_aggro
particle minecraft:flame ~ ~0.5 ~ 0.3 0.3 0.3 0.05 20
playsound minecraft:entity.wolf.growl hostile @a ~ ~ ~ 1 0.6
