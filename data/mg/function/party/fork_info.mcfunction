# Propose le choix de route à @s (embranchement de sa case)
execute if score @s mg.mpi matches 13 run dialog show @s mg:party_fork_1
execute if score @s mg.mpi matches 13 run tellraw @s [{"text":"⇆ EMBRANCHEMENT : ","color":"white","bold":true},{"text":"[1 : ☀ Route de la plage]","color":"yellow","click_event":{"action":"run_command","command":"trigger mg.dice set 11"},"hover_event":{"action":"show_text","value":"longue, tranquille"}},{"text":"  "},{"text":"[2 : ♨ Raccourci du volcan]","color":"red","click_event":{"action":"run_command","command":"trigger mg.dice set 12"},"hover_event":{"action":"show_text","value":"courte, dangereuse"}},{"text":"  (choix au hasard dans 15 s)","color":"gray","bold":false}]
execute if score @s mg.mpi matches 13 run tellraw @a[tag=mg.mpp,tag=!mg.mpcur] [{"selector":"@s","color":"yellow"},{"text":" hésite à l'embranchement : ☀ Route de la plage ou ♨ Raccourci du volcan ?","color":"gray"}]
execute if score @s mg.mpi matches 48 run dialog show @s mg:party_fork_2
execute if score @s mg.mpi matches 48 run tellraw @s [{"text":"⇆ EMBRANCHEMENT : ","color":"white","bold":true},{"text":"[1 : ❄ Tour du lac gelé]","color":"yellow","click_event":{"action":"run_command","command":"trigger mg.dice set 11"},"hover_event":{"action":"show_text","value":"longue, tranquille"}},{"text":"  "},{"text":"[2 : ❄ Grotte de glace]","color":"red","click_event":{"action":"run_command","command":"trigger mg.dice set 12"},"hover_event":{"action":"show_text","value":"courte, piégeuse"}},{"text":"  (choix au hasard dans 15 s)","color":"gray","bold":false}]
execute if score @s mg.mpi matches 48 run tellraw @a[tag=mg.mpp,tag=!mg.mpcur] [{"selector":"@s","color":"yellow"},{"text":" hésite à l'embranchement : ❄ Tour du lac gelé ou ❄ Grotte de glace ?","color":"gray"}]
