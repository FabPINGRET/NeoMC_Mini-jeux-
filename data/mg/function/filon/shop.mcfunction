# 🛒 Fenêtre du magasin : libellés et prix selon les niveaux de @s
execute store result storage mg:filon s.p int 1 run scoreboard players get @s mg.fnp
data modify storage mg:filon s.a1 set value "⛏ Pioche : niveau max"
execute if score @s mg.fnpk matches 1 run data modify storage mg:filon s.a1 set value "⛏ Pioche en diamant — 400 pts"
execute if score @s mg.fnpk matches 2 run data modify storage mg:filon s.a1 set value "⛏ Pioche en netherite — 1500 pts"
data modify storage mg:filon s.a2 set value "⚡ Efficacité : max"
execute if score @s mg.fnef matches 2 run data modify storage mg:filon s.a2 set value "⚡ Efficacité III — 150 pts"
