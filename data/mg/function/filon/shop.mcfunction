execute if score @s mg.fnef matches 4 run data modify storage mg:filon s.a2 set value "⚡ Efficacité V — 800 pts"
data modify storage mg:filon s.a3 set value "🍀 Fortune : max"
execute if score @s mg.fnfo matches 0 run data modify storage mg:filon s.a3 set value "🍀 Fortune I — 300 pts"
execute if score @s mg.fnfo matches 1 run data modify storage mg:filon s.a3 set value "🍀 Fortune II — 900 pts"
