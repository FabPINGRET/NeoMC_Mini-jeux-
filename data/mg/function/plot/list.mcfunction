# Liste cliquable des plots pris : visite en spectateur (@s = joueur)
tellraw @s [{"text":"— Plots de construction : clique pour visiter en spectateur —","color":"gold"}]
execute unless score $pn mg.st matches 1.. run return run tellraw @s [{"text":"Aucun plot n'est encore pris.","color":"gray"}]
execute if score $pn mg.st matches 1.. run tellraw @s [{"text":"[Plot 1] ","color":"aqua","click_event":{"action":"run_command","command":"trigger mg.pl set 101"},"hover_event":{"action":"show_text","value":"Visiter ce plot en spectateur"}},{"storage":"mg:plot","nbt":"owner.p1","color":"white"}]
