          "text": "Un des trois événements, annoncé 10 s avant",
          "color": "gray"
        }
      ],
      "action": {
        "type": "minecraft:run_command",
        "command": "trigger mg.opt set 68"
      }
    },
    {
      "label": [
        {
          "text": "👑 Roi Zombie",
