execute if score mainstory Story >= 3 Value if score mainstory Story < 13 Value at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ run tellraw @a[distance=..10,tag=mg.flw] [{"text":"<"},{"text":"King Glenman","color":"aqua"},{"text":"> The scourges have been stopped, but are we safe? Truly? I certainly feel more secure with you in my castle, hero.","color":"white"}]

