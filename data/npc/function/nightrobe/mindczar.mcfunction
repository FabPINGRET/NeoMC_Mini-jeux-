execute at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ run playsound minecraft:entity.strider.happy neutral @a[tag=mg.flw] ~ ~ ~ 1 1.2
execute if score mindczar Story matches 0 at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ run tellraw @a[distance=..10,tag=mg.flw] [{"text":"<"},{"text":"Mindczar","color":"light_purple"},{"text":"> You are here at last! I can fashion for you a blade able to cut the knot around the","color":"white"},{"text":" dust contagion","color":"gold"},{"text":", but I will need something from you first. There is a ","color":"white"},{"text":"Vault","color":"light_purple"},{"text":" in Limbohold where we keep a tool of ours able to anchor tricky beings called ","color":"white"},{"text":"Whispers ","color":"light_purple"},{"text":"to the fabric of reality. There are clues to find it hidden around the ","color":"white"},{"text":"Warped Land","color":"light_purple"},{"text":". Bring the tool to me and I'll tell you what you will do with it.","color":"white"}]
execute if score mindczar Story matches 1 at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ run tellraw @a[distance=..10,tag=mg.flw] [{"text":"<"},{"text":"Mindczar","color":"light_purple"},{"text":"> You have the ","color":"white"},{"text":"Anchorwand","color":"light_purple"},{"text":"! It will tell you if you're somewhat close to a Whisper. If you use the wand near one, it will be pulled fully into your dimension and will attempt to kill you! With the power released by","color":"white"},{"text":" 4 slain Whispers","color":"light_purple"},{"text":", I can transform the wand into a blade, strong enough to cut the spacial knot. If you want to learn more about Whispers and where to find them, visit our archives.","color":"white"}]
execute if score mindczar Story matches 2 at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ run tellraw @a[distance=..10,tag=mg.flw] [{"text":"<"},{"text":"Mindczar","color":"light_purple"},{"text":"> I need the power released by","color":"white"},{"text":" 4 slain Whispers","color":"light_purple"},{"text":" to transform the wand into a blade for you. If you want to learn more about Whispers and where to find them, visit our archives.","color":"white"}]

execute if score mindczar Story matches 3 at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ as @p[tag=mg.flw] if entity @s[nbt={SelectedItem:{id:"minecraft:carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{strings:['16']}}}}] run tellraw @a[distance=..10,tag=mg.flw] [{"text":"<"},{"text":"Mindczar","color":"light_purple"},{"text":"> Alakazoopy! I used the power from the slain ","color":"white"},{"text":"Whispers","color":"light_purple"},{"text":" to turn that wand into an Anchorblade! This blade is so solidly anchored, so spacially rigid, that it should be able to cleave the spacial knot around the ","color":"white"},{"text":"dust contagion","color":"gold"},{"text":".","color":"white"}]
execute if score mindczar Story matches 3 at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ as @p[tag=mg.flw] unless entity @s[tag=anchorblade] unless entity @s[nbt={SelectedItem:{id:"minecraft:carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{strings:['16']}}}}] run tellraw @a[distance=..10,tag=mg.flw] [{"text":"<"},{"text":"Mindczar","color":"light_purple"},{"text":"> Your ","color":"white"},{"text":"Anchorwand ","color":"light_purple"},{"text":"has absorbed the power of enough","color":"white"},{"text":" Whispers ","color":"light_purple"},{"text":"for me to turn it into a blade! Please show it to me.","color":"white"}]
execute if score mindczar Story matches 3 at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ as @p[tag=mg.flw] if entity @s[tag=anchorblade] run tellraw @a[distance=..10,tag=mg.flw] [{"text":"<"},{"text":"Mindczar","color":"light_purple"},{"text":"> Go, sever the knot and destroy the last contagion.","color":"white"}]

execute if score mindczar Story matches 3 at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ as @p[tag=mg.flw] if entity @s[nbt={SelectedItem:{id:"minecraft:carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{strings:['16']}}}}] run tag @s add anchorblade
execute if score mindczar Story matches 3 at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ as @p[tag=mg.flw] if entity @s[nbt={SelectedItem:{id:"minecraft:carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{strings:['16']}}}}] run playsound minecraft:zelda.itemget master @p[tag=mg.flw] ~ ~ ~ 0.5 1
execute if score mindczar Story matches 3 at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ as @p[tag=mg.flw] if entity @s[nbt={SelectedItem:{id:"minecraft:carrot_on_a_stick",count:1,components:{"minecraft:custom_model_data":{strings:['16']}}}}] run item replace entity @s weapon.mainhand with stone_sword[custom_name="Anchorblade",unbreakable={},tooltip_display={hidden_components:["unbreakable"]}] 1

execute if score mindczar Story matches 4 at @e[sort=nearest,limit=1,tag=npc,distance=0..] positioned ~ ~1 ~ run tellraw @a[distance=..10,tag=mg.flw] [{"text":"<"},{"text":"Mindczar","color":"light_purple"},{"text":"> It is as we feared. The contagions were agents of the ","color":"white"},{"text":"World Virus","color":"dark_aqua"},{"text":". We've seen him conquer countless dimensions, fled from him thousands of times, and the ","color":"white"},{"text":"Bell","color":"gold"},{"text":" was supposed to be our final refuge. A protective power unlike any other! But the contagions have worn down its defenses just enough. Space is stretching in","color":"white"},{"text":" Dwarf City ","color":"dark_aqua"},{"text":"and is about to tear! There is no time to delay, hero. ","color":"white"},{"text":"Go to Dwarf City","color":"light_purple"},{"text":", and defend this world at any cost.","color":"white"}]
execute if score mindczar Story matches 4 run setblock -9769 268 420 minecraft:redstone_block

